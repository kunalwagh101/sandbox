#!/bin/sh
set -eu

if command -v py >/dev/null 2>&1; then
  py -3 -m unittest discover -s tests -v
  py -3 scripts/verify_board.py
else
  python -m unittest discover -s tests -v
  python scripts/verify_board.py
fi

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File tests/Invoke-SourceAcceptance.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File tests/Invoke-SourceAcceptance.ps1
else
  echo "Airlock pre-push requires pwsh or powershell.exe to execute security behaviour." >&2
  exit 1
fi
